# =============================================================================
# ENVIRONMENT VARIABLES EXAMPLE FILE
# =============================================================================
# HOW TO USE THIS FILE:
# 1. Make a copy of this file and name it ".env" (remove the word "example")
# 2. Fill in your actual values where you see the placeholder text
# 3. Never share your .env file or push it to GitHub — keep it private!
# =============================================================================


# =============================================================================
# DATABASE URL (Required)
# =============================================================================
# This connects your app to your Prisma Postgres database.
#
# HOW TO GET YOUR DATABASE URL:
# Step 1 — Go to https://console.prisma.io and sign in (or create a free account)
# Step 2 — Click "New Project" and give it a name
# Step 3 — Choose "Prisma Postgres" as your database (you get 5 free databases)
# Step 4 — Once created, go to your project dashboard
# Step 5 — Click "Connect" and copy the connection string that starts with:
#           prisma+postgres://...
# Step 6 — Paste it below, replacing the placeholder text
#
# YOUR URL WILL LOOK SOMETHING LIKE THIS:
# prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY_HERE
# =============================================================================

DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY_HERE"


# =============================================================================
# BETTER AUTH SECRET (Required)
# =============================================================================
# This is a secret key used to sign and verify authentication tokens.
# It should be a long, random string — never share it with anyone.
#
# HOW TO GENERATE ONE:
# Option 1 — Run this command in your terminal:
#             openssl rand -base64 32
# Option 2 — Run this in your terminal:
#             node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Option 3 — Visit https://generate-secret.vercel.app/32 and copy the result
#
# Paste the generated secret below:
# =============================================================================

BETTER_AUTH_SECRET="paste-your-generated-secret-here"


# =============================================================================
# BETTER AUTH URL (Required)
# =============================================================================
# This is the base URL of your app. 
# - During development, keep it as http://localhost:3000
# - When you deploy to Vercel, change it to your live URL e.g. https://your-app.vercel.app
# =============================================================================

BETTER_AUTH_URL="http://localhost:3000"


# =============================================================================
# NEXT STEPS AFTER FILLING IN YOUR .env FILE:
# =============================================================================
#
# 1. Push your schema to the database:
#    npx prisma db push
#
# 2. Generate the Prisma client:
#    npx prisma generate
#
# 3. (Optional) Open Prisma Studio to view your data in a browser UI:
#    npx prisma studio
#
# 4. Start your development server:
#    npm run dev
#
# =============================================================================


